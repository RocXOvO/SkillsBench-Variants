# Version only the paper source and its current compiled PDF.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/paper/
/paper/*
!/paper/maintext-20260921/
/paper/maintext-20260921/*
!/paper/maintext-20260921/*.tex
!/paper/maintext-20260921/*.bib
!/paper/maintext-20260921/*.sty
!/paper/maintext-20260921/*.bst
!/paper/maintext-20260921/Makefile
!/paper/maintext-20260921/README.md
!/output/
/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/main.pdf

# Auditable derived selection records; raw experiment workspaces stay excluded.
!/paper/audits/
/paper/audits/*
!/paper/audits/coevo-server-selection-20260921/
!/paper/audits/six-run-maintext-20260921/
!/paper/audits/variant-maintext-20260921/

# Bilingual reading copy generated with Zotero PDF2zh.
!/output/pdf/main-bilingual-en-zh.pdf
!/output/pdf/main-revision-highlighted.pdf
!/paper/audits/zotero-bilingual-20260921/
!/paper/audits/full-variant-records-20260922/

# Original Overleaf PDF retained as the comparison baseline.
!/output/pdf/main-overleaf-original-20260921.pdf
